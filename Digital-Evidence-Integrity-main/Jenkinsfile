
pipeline {
    agent any

    options {
        disableConcurrentBuilds()
    }

    environment {
        VM_IP = '20.193.134.57'
        VM_USER = 'azureuser'
    }

    stages {
        stage('Deploy to Azure VM') {
            steps {
                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'azure-vm-ssh',
                        keyFileVariable: 'SSH_KEY',
                        usernameVariable: 'SSH_USER'
                    ),
                    string(
                        credentialsId: 'SECRET_KEY',
                        variable: 'APP_SECRET'
                    ),
                    string(
                        credentialsId: 'POSTGRES_PASSWORD',
                        variable: 'DB_PASS'
                    )
                ]) {
                    powershell '''
                        $ErrorActionPreference = "Stop"

                        $sshExe = (Get-Command ssh.exe -ErrorAction Stop).Source

                        # Ensure secret key is at least 32 characters
                        $secretKey = $env:APP_SECRET
                        if (-not $secretKey -or $secretKey.Length -lt 32) {
                            $secretKey = "$secretKey" + "secure-padding-key-forensics-2026-xyz"
                        }

                        # Create environment file (APP_ENV=development ensures HTTP cookies work without HTTPS)
                        $envText = @"
APP_ENV=development
HOST=0.0.0.0
PORT=5000
SECRET_KEY=$secretKey
POSTGRES_USER=forensics
POSTGRES_PASSWORD=$env:DB_PASS
POSTGRES_DB=forensics
"@
                        # Strip Windows CRLF line endings so Linux doesn't corrupt environment variables
                        $envText = $envText.Replace("`r`n", "`n")

                        # Encode environment file for safe SSH transfer
                        $envBase64 = [Convert]::ToBase64String(
                            [Text.Encoding]::UTF8.GetBytes($envText)
                        )

                        # Commands executed on Azure VM
                        $remoteScript = @'
set -e

BASE_DIR="$HOME/digital-evidence"
REPO_DIR="$BASE_DIR/Cyber-Digital"
PROJECT_DIR="$REPO_DIR/Digital-Evidence-Integrity-main"

mkdir -p "$BASE_DIR"

if [ ! -d "$REPO_DIR/.git" ]; then
    git clone --branch main \
      "https://github.com/AmulyaAmmu-46/Cyber-Digital.git" \
      "$REPO_DIR"
else
    git -C "$REPO_DIR" pull --ff-only origin main
fi

cd "$PROJECT_DIR"

if [ ! -f docker-compose.yml ]; then
    echo "ERROR: docker-compose.yml not found"
    exit 1
fi

printf '%s' '__ENV_BASE64__' | base64 -d > .env
chmod 600 .env

if command -v docker-compose >/dev/null 2>&1; then
    COMPOSE="docker-compose"
else
    COMPOSE="docker compose"
fi

$COMPOSE config -q
$COMPOSE down
$COMPOSE up -d --build

# Wait for containers to start
sleep 5

$COMPOSE ps

echo "=== Web Container Logs ==="
$COMPOSE logs --tail=40 web

# Auto-initialize database tables if not yet created
$COMPOSE exec -T web python -c "from app import create_app; from app.extensions import db; a = create_app(); a.app_context().push(); db.create_all(); print('Database tables verified successfully.')" || true
'@

                        $remoteScript = $remoteScript.Replace(
                            '__ENV_BASE64__',
                            $envBase64
                        )

                        # Strip CRLF to prevent bash 'set: command not found' errors
                        $remoteScript = $remoteScript.Replace("`r`n", "`n")

                        # Write remote script as UTF-8 without BOM
                        $scriptPath = Join-Path $env:TEMP "azure-deploy-$env:BUILD_NUMBER.sh"

                        [IO.File]::WriteAllText(
                            $scriptPath,
                            $remoteScript,
                            (New-Object System.Text.UTF8Encoding($false))
                        )

                        # Copy SSH key to a dedicated temp file and restrict permissions for Windows OpenSSH
                        $localKey = Join-Path $env:TEMP "id_azure_$env:BUILD_NUMBER.pem"
                        Copy-Item -Path $env:SSH_KEY -Destination $localKey -Force

                        $acl = Get-Acl $localKey
                        $acl.SetAccessRuleProtection($true, $false)
                        $identity = [System.Security.Principal.WindowsIdentity]::GetCurrent()
                        $rule = New-Object System.Security.AccessControl.FileSystemAccessRule(
                            $identity.User,
                            [System.Security.AccessControl.FileSystemRights]::FullControl,
                            [System.Security.AccessControl.AccessControlType]::Allow
                        )
                        $acl.AddAccessRule($rule)
                        Set-Acl -Path $localKey -AclObject $acl

                        try {
                            # Connect using the secured SSH key
                            $psi = New-Object System.Diagnostics.ProcessStartInfo
                            $psi.FileName = $sshExe
                            $psi.Arguments = '-i "' + $localKey +
                                '" -o StrictHostKeyChecking=accept-new ' +
                                $env:SSH_USER + '@' + $env:VM_IP + ' bash -s'

                            $psi.UseShellExecute = $false
                            $psi.RedirectStandardInput = $true
                            $psi.RedirectStandardOutput = $true
                            $psi.RedirectStandardError = $true

                            $process = New-Object System.Diagnostics.Process
                            $process.StartInfo = $psi

                            $null = $process.Start()

                            # Read stdout and stderr asynchronously to prevent deadlocks
                            $stdoutTask = $process.StandardOutput.ReadToEndAsync()
                            $stderrTask = $process.StandardError.ReadToEndAsync()

                            $scriptContent = [IO.File]::ReadAllText($scriptPath)
                            $process.StandardInput.Write($scriptContent)
                            $process.StandardInput.Close()

                            $process.WaitForExit()

                            $stdout = $stdoutTask.Result
                            $stderr = $stderrTask.Result

                            if ($stdout) { Write-Output $stdout }
                            if ($stderr) { Write-Output $stderr }

                            if ($process.ExitCode -ne 0) {
                                throw "SSH deployment failed with exit code $($process.ExitCode)"
                            }
                        }
                        finally {
                            Remove-Item $scriptPath -Force -ErrorAction SilentlyContinue
                            Remove-Item $localKey -Force -ErrorAction SilentlyContinue
                        }
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Deployment completed successfully!'
            echo 'Application URL: http://20.193.134.57:5000'
        }

        failure {
            echo 'Deployment failed. Check Jenkins Console Output.'
        }
    }
}
